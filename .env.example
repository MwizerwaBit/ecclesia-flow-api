# Copy to .env and fill in real secrets for local/dev use. Never commit .env.

ENVIRONMENT=development

# Owner/migration connection — used by `prisma migrate`/`prisma db execute`
# (and read by prisma/schema.prisma's datasource block), never by the running
# API process, which must connect as app_tenant/app_platform so Postgres
# Row-Level Security actually applies. Points at a local native Postgres
# install here, not Docker — adjust host/port/user/password to match yours.
DATABASE_URL=postgresql://ecclesiaDb:ecclesiaDb@localhost:5432/ecclesia_flow

# app_tenant: every ordinary request. RLS-bound — can only ever see one
# tenant's rows per transaction, set via app.tenant_id.
DATABASE_URL_APP=postgresql://app_tenant:change_me_tenant_pw@localhost:5432/ecclesia_flow
APP_TENANT_DB_PASSWORD=change_me_tenant_pw

# app_platform: the platform-admin service only. BYPASSRLS — every connection
# on this role must be paired with an explicit audit_logs write (tenant_id=null).
DATABASE_URL_PLATFORM=postgresql://app_platform:change_me_platform_pw@localhost:5432/ecclesia_flow
APP_PLATFORM_DB_PASSWORD=change_me_platform_pw

# JWT signing. Access tokens are short-lived; refresh tokens are rotated and
# stored hashed server-side so a stolen token can be revoked.
JWT_SECRET=dev-only-secret-change-in-production-use-a-random-64-byte-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
STEP_UP_TOKEN_TTL_MINUTES=5

# MFA secrets are encrypted at rest with this key before being stored
# (application-layer envelope encryption, per docs/database-design.md §3).
MFA_ENCRYPTION_KEY=dev-only-32-byte-key-change-me-now

# CORS — the frontend origin(s) allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Rate limiting backend. "memory" for local dev; use a real Redis URL in prod
# so limits are shared across processes.
RATE_LIMIT_STORAGE_URL=memory://

# Media storage (Phase 7). S3-compatible — MinIO locally, S3 in production.
MEDIA_S3_ENDPOINT_URL=http://localhost:9000
MEDIA_S3_BUCKET=ecclesia-flow-media
MEDIA_S3_ACCESS_KEY=minioadmin
MEDIA_S3_SECRET_KEY=minioadmin
MEDIA_S3_REGION=us-east-1
MEDIA_S3_PUBLIC_BASE_URL=http://localhost:9000/ecclesia-flow-media

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY empty to use the built-in demo checkout (test cards,
# no network calls). To go live: create a Stripe account, then fill these in.
#   STRIPE_SECRET_KEY        Dashboard → Developers → API keys → Secret key (sk_live_… / sk_test_…)
#   STRIPE_PUBLISHABLE_KEY   same page, Publishable key (pk_…)
#   STRIPE_WEBHOOK_SECRET    Dashboard → Developers → Webhooks → add endpoint
#                            https://<your-api>/api/v1/billing/webhooks/stripe
#                            events: checkout.session.completed, invoice.payment_failed,
#                            customer.subscription.deleted → "Signing secret" (whsec_…)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_CURRENCY=usd
# Where checkout returns to, and where invitation links point.
FRONTEND_URL=http://localhost:5173

# ── Personal data ───────────────────────────────────────────────────────────
# Keys ID-document numbers (hash + encryption). Long random value; never reuse
# the JWT or MFA key. Changing it later breaks matching of existing IDs.
PII_ENCRYPTION_KEY=change-me-to-a-long-random-value
# Private (non-public) uploads such as government certificates.
PRIVATE_FILES_DIR=private_uploads

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Email (password resets) ──────────────────────────────────────────────
# Leave SMTP_HOST empty in development: messages are written to DEV_OUTBOX_DIR
# (git-ignored) so you can open the link. Production refuses to start without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=EcclesiaFlow <no-reply@example.org>
SMTP_STARTTLS=true
DEV_OUTBOX_DIR=dev_outbox

# ── Account recovery ─────────────────────────────────────────────────────
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_PER_HOUR=3

# ── Request size limits (bytes). Keep the reverse proxy's limit at the upload value.
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_BODY_BYTES=11534336

# NOT here: AUDIT_CHECKPOINT_KEY. It must live outside the app's environment —
# see docs/OPERATIONS.md and scripts/audit_checkpoint.py.
